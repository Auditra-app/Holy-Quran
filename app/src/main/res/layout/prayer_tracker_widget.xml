<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tracker_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Header Row -->
    <LinearLayout
        android:id="@+id/widget_tracker_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_tracker_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🕌 متابع الصلوات • Prayers Tracker"
            android:textColor="#D4AF37"
            android:textSize="16.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/widget_tracker_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_badge"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/widget_tracker_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 5 صلوات"
                android:textColor="#0B2A22"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Subtitle / Motivational Hadith Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_widget_card"
        android:padding="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_tracker_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="«خير الأعمال.. الصلاة على وقتها» • انقر لتحديد الصلاة"
            android:textColor="#E0F2F1"
            android:textSize="13.5sp"
            android:gravity="center"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 5 Prayers Grid Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- FAJR -->
        <LinearLayout
            android:id="@+id/widget_tracker_fajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_time_pill"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp"
            android:paddingHorizontal="2dp">

            <TextView
                android:id="@+id/widget_fajr_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⬜"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/widget_fajr_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:text="الفجر"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- DHUHR -->
        <LinearLayout
            android:id="@+id/widget_tracker_dhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_time_pill"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp"
            android:paddingHorizontal="2dp">

            <TextView
                android:id="@+id/widget_dhuhr_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⬜"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/widget_dhuhr_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:text="الظهر"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ASR -->
        <LinearLayout
            android:id="@+id/widget_tracker_asr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_time_pill"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp"
            android:paddingHorizontal="2dp">

            <TextView
                android:id="@+id/widget_asr_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⬜"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/widget_asr_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:text="العصر"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- MAGHRIB -->
        <LinearLayout
            android:id="@+id/widget_tracker_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_time_pill"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp"
            android:paddingHorizontal="2dp">

            <TextView
                android:id="@+id/widget_maghrib_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⬜"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/widget_maghrib_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:text="المغرب"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ISHA -->
        <LinearLayout
            android:id="@+id/widget_tracker_isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_time_pill"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="6dp"
            android:paddingHorizontal="2dp">

            <TextView
                android:id="@+id/widget_isha_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⬜"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/widget_isha_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:text="العشاء"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
