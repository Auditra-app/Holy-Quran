<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_audio_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_app_logo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_stat_quran"
            android:tint="#FFD700"
            android:contentDescription="Quran Emblem" />

        <TextView
            android:id="@+id/widget_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="القرآن الكريم • مشغل التلاوة"
            android:textColor="#FFD700"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_badge_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_badge"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp"
            android:text="سورة كاملة"
            android:textColor="#FFFAF0"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Player Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_widget_card"
        android:orientation="vertical"
        android:padding="9dp"
        android:gravity="center_vertical">

        <!-- Info Row: Avatar + Title/Reciter + Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_widget_avatar_circle">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_stat_quran"
                    android:tint="#FFD700"
                    android:contentDescription="Voice Avatar" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_audio_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="سورة الفاتحة"
                    android:textColor="#FFFFFF"
                    android:textSize="15.5sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_audio_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="مشاري راشد العفاسي"
                    android:textColor="#9AE6B4"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_audio_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="جاهز للتشغيل"
                android:textColor="#FFD700"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cumulative Progress Bar -->
        <ProgressBar
            android:id="@+id/widget_audio_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_widget_quran_progress" />

        <!-- Media Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_btn_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_widget_btn_circle"
                android:src="@drawable/ic_widget_prev"
                android:padding="7dp"
                android:contentDescription="Previous" />

            <ImageButton
                android:id="@+id/widget_btn_play_pause"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginHorizontal="14dp"
                android:background="@drawable/bg_widget_play_btn"
                android:src="@drawable/ic_widget_play"
                android:padding="10dp"
                android:contentDescription="Play/Pause" />

            <ImageButton
                android:id="@+id/widget_btn_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_widget_btn_circle"
                android:src="@drawable/ic_widget_next"
                android:padding="7dp"
                android:contentDescription="Next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
